{
  "name": "cyberbnb-qa-typescript",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:smoke": "playwright test --grep @smoke",
    "test:core": "playwright test --grep-invert @candidate",
    "test:ui": "playwright test --ui",
    "summary": "node scripts/summarize.cjs",
    "submit": "node scripts/run-and-summarize.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
